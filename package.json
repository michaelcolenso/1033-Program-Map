{
  "name": "1033-program-map",
  "version": "1.0.0",
  "description": "Interactive map visualizing the US Department of Defense 1033 Program - tracking military equipment transfers to law enforcement",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "mocha --timeout 10000",
    "test:watch": "mocha --watch",
    "lint": "eslint .",
    "seed": "node scripts/seed.js",
    "seed:skip": "node scripts/seed.js --skip-existing",
    "seed:force": "node scripts/seed.js --force"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelcolenso/1033-Program-Map"
  },
  "keywords": [
    "1033",
    "police",
    "military",
    "equipment",
    "map",
    "visualization",
    "data-visualization",
    "leaflet",
    "d3"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3"
    }
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "connect-assets": "^6.0.1",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-flash": "^0.0.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "less": "^4.2.0",
    "lodash": "^4.18.1",
    "lusca": "^1.7.0",
    "mongodb": "^6.12.0",
    "mongoose": "^8.9.4",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pug": "^3.0.3",
    "socket.io": "^4.8.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "chai": "^4.5.0",
    "eslint": "^9.18.0",
    "mocha": "^11.0.1",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
