.git
.gitignore
.gitattributes

# Docker
Dockerfile
.dockerignore
docker-compose.yml

# CI/CD
.travis.yml
.github

# Documentation
*.md
!README.md
CONTRIBUTING.md

# Temporary files
tmp
temp
*.tmp
